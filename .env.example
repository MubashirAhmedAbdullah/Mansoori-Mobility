# Copy this file to .env.local before enabling the real API.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Set only after commercial policy is approved; 1000 basis points = 10% (illustration only).
FREIGHT_COMMISSION_BPS=
NODE_ENV=development

# Intentionally left provider-neutral: add credentials only after selecting a
# contracted payment provider that supports the required Pakistan marketplace flow.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
